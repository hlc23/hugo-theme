{
  "name": "root-hugo-theme",
  "version": "1.0.0",
  "description": "A dark-first, bilingual Hugo theme for security write-ups, CTF logs, and Reveal.js slide decks.",
  "license": "MIT",
  "author": "hlc23",
  "homepage": "https://github.com/hlc23/hugo-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlc23/hugo-theme.git"
  },
  "keywords": ["hugo", "hugo-theme", "tailwindcss", "ctf", "security", "dark-mode"],
  "scripts": {
    "example:dev": "cd exampleSite && hugo server --themesDir ../.. --disableFastRender",
    "example:build": "cd exampleSite && hugo --themesDir ../.."
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "cssnano": "^6.1.2",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.10"
  }
}
